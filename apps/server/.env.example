SPRING_PROFILES_ACTIVE=local

# PostgreSQL
# Example: jdbc:postgresql://<ubuntu-vm-host>:5432/purple_nexus
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=purple
SPRING_DATASOURCE_PASSWORD=

# Redis
SPRING_DATA_REDIS_HOST=
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# FastAPI Agent
AGENT_BASE_URL=http://localhost:8000
AGENT_SERVICE_TOKEN=

# S3-compatible object storage
# Example: http://<ubuntu-vm-host>:9000
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=purple-nexus-assets
S3_REGION=us-east-1
S3_PATH_STYLE_ACCESS=true